<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StoryToon & Voice Studio AI - Generator Ilustrasi & Video merger</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Fredoka', 'cursive'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        cartoon: {
                            purple: '#8b5cf6',
                            pink: '#ec4899',
                            amber: '#f59e0b',
                            blue: '#3b82f6',
                            indigo: '#6366f1'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .story-card-shadow {
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090d16;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
        @keyframes pulse-border {
            0%, 100% { border-color: rgba(139, 92, 246, 0.4); }
            50% { border-color: rgba(236, 72, 153, 0.8); }
        }
        .active-generating {
            animation: pulse-border 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="h-full flex flex-col font-sans antialiased bg-slate-950 text-slate-100 selection:bg-purple-500 selection:text-white">

    <header class="border-b border-slate-800 bg-slate-950/90 backdrop-blur sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-pink-500 to-amber-400 flex items-center justify-center text-white shadow-lg shadow-purple-500/20 font-display text-xl font-bold">
                    🎬
                </div>
                <div>
                    <h1 class="font-display text-lg sm:text-xl font-bold bg-gradient-to-r from-purple-400 via-pink-300 to-amber-200 bg-clip-text text-transparent">
                        StoryToon & Voice Studio AI
                    </h1>
                    <p class="text-xs text-slate-400 hidden md:block">Generator Ilustrasi Kartun Konsisten, Voice Over & Transisi Sinematik</p>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="hidden sm:inline">Character Lock Engine</span> Active
                </span>
                <button onclick="scrollToSection('story-input-section')" class="text-xs font-medium px-3 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white transition shadow-md shadow-purple-600/20 flex items-center gap-1.5">
                    <i data-lucide="plus" class="w-4 h-4"></i> Buat Baru
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-8">

        <section id="story-input-section" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Left Side: Story Input Form -->
            <div class="lg:col-span-7 flex flex-col gap-4 glass-panel p-5 sm:p-6 rounded-2xl shadow-xl">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <label for="story-text" class="font-display text-lg font-semibold text-slate-100 flex items-center gap-2">
                        <i data-lucide="book-open" class="w-5 h-5 text-purple-400"></i>
                        Naskah / Script Cerita
                    </label>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-slate-400">Preset:</span>
                        <select id="preset-select" onchange="loadPresetStory(this.value)" class="text-xs bg-slate-900 border border-slate-700 text-purple-300 rounded-lg px-2.5 py-1 focus:outline-none focus:border-purple-500">
                            <option value="">-- Pilih Contoh --</option>
                            <option value="bimo_bolt">Petualangan Bimo & Robot Bolt</option>
                            <option value="kancil">Kancil & Buaya Cerdas</option>
                            <option value="space">Astronaut Cilik di Planet Permen</option>
                            <option value="dragon">Naga Kecil Pengawal Hutan</option>
                        </select>
                    </div>
                </div>

                <div class="relative">
                    <textarea id="story-text" rows="7" 
                        placeholder="Tulis naskah cerita Anda di sini. Sistem akan secara otomatis mengunci ciri fisik karakter (wajah, baju, mata, gaya) agar tetap sama di seluruh adegan..." 
                        class="w-full bg-slate-950/90 border border-slate-800 rounded-xl p-4 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500 transition resize-y"></textarea>
                    
                    <div class="flex flex-wrap items-center justify-between gap-2 mt-2 px-1 text-xs text-slate-400">
                        <div class="flex items-center gap-3">
                            <span><strong id="stat-char" class="text-purple-300">0</strong> Karakter</span>
                            <span>•</span>
                            <span><strong id="stat-words" class="text-purple-300">0</strong> Kata</span>
                            <span>•</span>
                            <span class="text-amber-400">Est. Suara: <strong id="stat-est-time">00:00</strong></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="normalizeNumbersInScript()" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-md transition text-xs flex items-center gap-1" title="Konversi angka dan Rp ke kata-kata lisan">
                                <i data-lucide="spell-check" class="w-3.5 h-3.5 text-indigo-400"></i> Normalisasi Ejaan
                            </button>
                            <button onclick="clearScript()" class="px-2 py-1 bg-slate-800 hover:bg-red-950/40 text-slate-400 hover:text-red-300 rounded-md transition text-xs">
                                Hapus
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Custom Character Prompt Customization (Optional Override) -->
                <div class="p-3 bg-slate-950/70 border border-purple-500/30 rounded-xl flex flex-col gap-1.5">
                    <div class="flex items-center justify-between">
                        <label for="custom-character-override" class="text-xs font-semibold text-purple-300 flex items-center gap-1.5">
                            <i data-lucide="user-check" class="w-4 h-4 text-pink-400"></i>
                            Kunci Desain Karakter (Opsional / Otomatis AI)
                        </label>
                        <span class="text-[10px] text-slate-400">Biarkan kosong agar AI mendeteksi otomatis</span>
                    </div>
                    <input type="text" id="custom-character-override" placeholder="Contoh: Bimo (anak laki-laki 8 tahun, kaos merah bercorak bintang, celana jeans biru, rambut cokelat). Bolt (robot perak kecil, mata biru menyala)." 
                        class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-purple-500">
                </div>

                <!-- Customization Options Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-1">
                    <div>
                        <label for="art-style" class="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5">
                            <i data-lucide="palette" class="w-4 h-4 text-purple-400"></i>
                            Gaya Seni Visual
                        </label>
                        <select id="art-style" class="w-full bg-slate-900 border border-slate-700 text-slate-200 rounded-xl px-2.5 py-2 text-xs focus:outline-none focus:border-purple-500">
                            <option value="2d-storybook" selected>2D Classic Storybook</option>
                            <option value="3d-pixar">3D Pixar Animated</option>
                            <option value="anime-cute">Anime Fantasy Cute</option>
                            <option value="comic-vibrant">Vibrant Comic Book</option>
                            <option value="watercolor">Soft Watercolor</option>
                        </select>
                    </div>

                    <div>
                        <label for="scene-count" class="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5">
                            <i data-lucide="layers" class="w-4 h-4 text-pink-400"></i>
                            Jumlah Adegan
                        </label>
                        <select id="scene-count" class="w-full bg-slate-900 border border-slate-700 text-slate-200 rounded-xl px-2.5 py-2 text-xs focus:outline-none focus:border-purple-500">
                            <option value="auto" selected>Otomatis (3-6 Adegan)</option>
                            <option value="3">3 Adegan Singkat</option>
                            <option value="4">4 Adegan Standard</option>
                            <option value="5">5 Adegan Detail</option>
                            <option value="6">6 Adegan Panjang</option>
                        </select>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label for="voice-talent" class="block text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                                <i data-lucide="mic" class="w-4 h-4 text-indigo-400"></i>
                                Talenta Suara
                            </label>
                            <button type="button" onclick="previewVoiceTalent()" id="btn-preview-voice" class="text-[11px] font-medium text-indigo-300 hover:text-white bg-indigo-950/80 hover:bg-indigo-900 border border-indigo-500/40 px-2 py-0.5 rounded-lg flex items-center gap-1 transition shadow-sm" title="Dengarkan contoh suara talenta ini">
                                <i data-lucide="volume-2" class="w-3 h-3 text-indigo-400" id="preview-voice-icon"></i>
                                <span id="preview-voice-text">Dengar</span>
                            </button>
                        </div>
                        <select id="voice-talent" onchange="resetVoicePreviewState()" class="w-full bg-slate-900 border border-slate-700 text-slate-200 rounded-xl px-2.5 py-2 text-xs focus:outline-none focus:border-purple-500">
                            <option value="Kore" selected>Kore (Wanita - Mantap & Jelas)</option>
                            <option value="Puck">Puck (Pria - Ceria & Energik)</option>
                            <option value="Zephyr">Zephyr (Wanita - Cerah & Ceria)</option>
                            <option value="Charon">Charon (Pria - Dalam & Informatif)</option>
                            <option value="Fenrir">Fenrir (Pria - Antusias & Seru)</option>
                            <option value="Leda">Leda (Wanita - Muda & Lembut)</option>
                            <option value="Aoede">Aoede (Wanita - Hangat & Naratif)</option>
                        </select>
                    </div>

                    <div>
                        <label for="voice-style" class="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5">
                            <i data-lucide="smile" class="w-4 h-4 text-amber-400"></i>
                            Gaya Suara
                        </label>
                        <select id="voice-style" class="w-full bg-slate-900 border border-slate-700 text-slate-200 rounded-xl px-2.5 py-2 text-xs focus:outline-none focus:border-purple-500">
                            <option value="Say cheerfully in clear Indonesian">Ceria & Riang</option>
                            <option value="Say with storytelling drama and warmth in Indonesian" selected>Dongeng & Hangat</option>
                            <option value="Say enthusiastically with high energy in Indonesian">Semangat & Energik</option>
                            <option value="Say softly and gently like a bedtime story in Indonesian">Lembut & Tenang</option>
                            <option value="Say in a suspenseful, mysterious movie narrator voice in Indonesian">Misterius & Misteri</option>
                        </select>
                    </div>
                </div>

                <!-- NEW: Transition Type & Aspect Ratio Settings Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                    <!-- Transition Type Selector -->
                    <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 text-xs flex flex-col justify-between gap-1.5">
                        <label for="transition-type" class="text-slate-300 font-semibold flex items-center gap-1.5">
                            <i data-lucide="wand2" class="w-4 h-4 text-purple-400"></i> Tipe Transisi Antar Adegan:
                        </label>
                        <select id="transition-type" class="w-full bg-slate-900 border border-slate-700 text-purple-300 rounded-lg px-2.5 py-2 text-xs focus:outline-none focus:border-purple-500">
                            <option value="crossfade" selected>✨ Crossfade Halus (Lembut Storybook)</option>
                            <option value="fade-black">⬛ Fade to Black (Sinematik Hitam)</option>
                            <option value="slide-left">⬅️ Slide ke Kiri (Geser Dinamis)</option>
                            <option value="zoom-burst">🔍 Zoom Burst (Dramatis)</option>
                            <option value="wipe-right">➡️ Wipe Melintang (Gaya Televisi)</option>
                        </select>
                    </div>

                    <!-- Aspect Ratio Selector -->
                    <div class="flex flex-col justify-between bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs">
                        <span class="text-slate-300 font-semibold flex items-center gap-1.5 mb-1.5">
                            <i data-lucide="aspect-ratio" class="w-4 h-4 text-pink-400"></i> Rasio Gambar Layout:
                        </span>
                        <div class="flex items-center gap-2">
                            <label class="cursor-pointer flex-1 text-center">
                                <input type="radio" name="aspect-ratio" value="16:9" checked class="peer sr-only">
                                <span class="block px-2 py-1.5 rounded-lg bg-slate-900 text-slate-400 border border-slate-700 peer-checked:bg-purple-600 peer-checked:text-white peer-checked:border-purple-500 transition">16:9 Landscape</span>
                            </label>
                            <label class="cursor-pointer flex-1 text-center">
                                <input type="radio" name="aspect-ratio" value="9:16" class="peer sr-only">
                                <span class="block px-2 py-1.5 rounded-lg bg-slate-900 text-slate-400 border border-slate-700 peer-checked:bg-purple-600 peer-checked:text-white peer-checked:border-purple-500 transition">9:16 Portrait</span>
                            </label>
                            <label class="cursor-pointer flex-1 text-center">
                                <input type="radio" name="aspect-ratio" value="1:1" class="peer sr-only">
                                <span class="block px-2 py-1.5 rounded-lg bg-slate-900 text-slate-400 border border-slate-700 peer-checked:bg-purple-600 peer-checked:text-white peer-checked:border-purple-500 transition">1:1 Square</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="pt-2">
                    <button id="btn-generate-story" onclick="startStoryPipeline()" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-purple-600 via-pink-600 to-amber-500 hover:from-purple-500 hover:via-pink-500 hover:to-amber-400 text-white font-display font-semibold text-base shadow-lg shadow-purple-600/30 hover:shadow-purple-600/50 transition-all transform active:scale-[0.99] flex items-center justify-center gap-2">
                        <i data-lucide="sparkles" class="w-5 h-5"></i>
                        <span>Proses Storyboard Konsisten & Suara AI</span>
                    </button>
                </div>
            </div>

            <!-- Right Side: Features Highlight -->
            <div class="lg:col-span-5 flex flex-col justify-between glass-panel p-5 sm:p-6 rounded-2xl bg-slate-900/60 shadow-xl">
                <div>
                    <h3 class="font-display text-base font-bold text-slate-100 flex items-center gap-2 mb-3">
                        <i data-lucide="sparkles" class="w-5 h-5 text-amber-400"></i>
                        Fitur Transisi Profesional & Multimodal AI
                    </h3>
                    <ul class="space-y-3 text-xs text-slate-300">
                        <li class="flex items-start gap-3">
                            <div class="p-2 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 shrink-0">
                                <i data-lucide="wand2" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <strong class="text-slate-100 block font-semibold mb-0.5">1. Pilihan Transisi Antar Adegan</strong>
                                Pilih efek transisi sinematik (Crossfade, Fade to Black, Slide, Zoom Burst, Wipe) untuk menyambungkan adegan cerita secara profesional.
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="p-2 rounded-xl bg-pink-500/10 border border-pink-500/20 text-pink-400 shrink-0">
                                <i data-lucide="user-check" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <strong class="text-slate-100 block font-semibold mb-0.5">2. Consistent Character Anchor</strong>
                                AI secara cermat membuat paspor visual karakter (pakaian, warna mata, potongan rambut) agar sama persis di setiap adegan.
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="p-2 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 shrink-0">
                                <i data-lucide="volume-2" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <strong class="text-slate-100 block font-semibold mb-0.5">3. Gemini Voice TTS Engine</strong>
                                Menghasilkan narasi suara manusia yang kaya ekspresi dan natural dalam Bahasa Indonesia.
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="p-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 shrink-0">
                                <i data-lucide="video" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <strong class="text-slate-100 block font-semibold mb-0.5">4. Canvas Seamless Video Export</strong>
                                Menggabungkan seluruh adegan gambar & suara menjadi 1 file video utuh lengkap dengan efek transisi terpilih.
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="mt-6 p-4 rounded-xl bg-purple-950/40 border border-purple-500/20 text-xs text-purple-200/90 flex items-center gap-3">
                    <i data-lucide="clapperboard" class="w-8 h-8 text-pink-400 shrink-0"></i>
                    <div>
                        <strong class="font-semibold block text-purple-300 mb-0.5">Kualitas Produksi Profesional</strong>
                        Kombinasikan karakter konsisten dan transisi adegan pilihan Anda untuk hasil video animasi cerita terbaik.
                    </div>
                </div>
            </div>
        </section>

        <!-- Progress Indicator -->
        <section id="progress-section" class="hidden glass-panel p-5 rounded-2xl border border-purple-500/40">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-3">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 rounded-xl bg-purple-500/20 text-purple-400">
                        <i data-lucide="loader-2" class="w-6 h-6 animate-spin" id="progress-spinner"></i>
                    </div>
                    <div>
                        <h4 class="font-display font-semibold text-sm text-slate-100" id="progress-title">Sedang Menganalisis & Mengunci Karakter...</h4>
                        <p class="text-xs text-slate-400" id="progress-subtitle">Mencatat model visual karakter dan menyiapkan storyboard...</p>
                    </div>
                </div>
                <div class="text-xs font-semibold text-purple-300 shrink-0 bg-purple-950/80 px-3 py-1.5 rounded-lg border border-purple-800/50" id="progress-count">
                    0 / 0 Selesai
                </div>
            </div>
            
            <div class="w-full bg-slate-900 rounded-full h-3 overflow-hidden border border-slate-800 p-0.5">
                <div id="progress-bar" class="bg-gradient-to-r from-purple-500 via-pink-500 to-amber-400 h-full rounded-full transition-all duration-300 w-0"></div>
            </div>
        </section>

        <!-- Storyboard Result Section -->
        <section id="storyboard-section" class="hidden flex flex-col gap-6">
            
            <!-- Character Anchor Details Banner -->
            <div id="character-anchor-card" class="glass-panel p-4 sm:p-5 rounded-2xl border border-pink-500/30 bg-gradient-to-r from-purple-950/40 via-slate-900/80 to-slate-900/40 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-xl">
                <div class="flex items-start gap-3">
                    <div class="p-2.5 rounded-xl bg-pink-500/20 text-pink-300 border border-pink-500/30 shrink-0 mt-0.5 md:mt-0">
                        <i data-lucide="user-check" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-pink-400 block mb-0.5">Character Lock Sheet (Model Karakter Konsisten)</span>
                        <h3 class="font-display font-semibold text-sm sm:text-base text-slate-100" id="character-summary-title">Spesifikasi Karakter Terkunci</h3>
                        <p class="text-xs text-slate-300 leading-relaxed mt-1" id="character-summary-desc">Loading detail karakter...</p>
                    </div>
                </div>
                <button onclick="editCharacterSheetPrompt()" class="shrink-0 px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-purple-300 text-xs font-medium rounded-xl border border-slate-700 flex items-center gap-1.5 transition">
                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Sesuaikan Karakter
                </button>
            </div>

            <!-- Controls and Header Bar -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
                <div>
                    <h2 class="font-display text-2xl font-bold text-slate-100 flex items-center gap-2">
                        <i data-lucide="film" class="w-6 h-6 text-purple-400"></i>
                        Hasil Storyboard & Voiceover Studio
                    </h2>
                    <p class="text-xs text-slate-400" id="story-stats-text">Naskah berhasil diproses menjadi beberapa adegan</p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <!-- Tab View Switcher -->
                    <div class="bg-slate-900 p-1 rounded-xl border border-slate-800 flex items-center gap-1 text-xs font-medium">
                        <button id="tab-grid-btn" onclick="switchViewMode('grid')" class="px-3 py-1.5 rounded-lg bg-purple-600 text-white shadow flex items-center gap-1.5">
                            <i data-lucide="layout-grid" class="w-4 h-4"></i> Grid Adegan
                        </button>
                        <button id="tab-storybook-btn" onclick="switchViewMode('storybook')" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 flex items-center gap-1.5">
                            <i data-lucide="book-open" class="w-4 h-4"></i> Mode Buku Cerita
                        </button>
                    </div>

                    <!-- Cinema Player Trigger -->
                    <button onclick="startCinemaPresentation()" class="px-3.5 py-1.5 text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl border border-slate-700 shadow flex items-center gap-1.5 transition">
                        <i data-lucide="play-circle" class="w-4 h-4 text-pink-400"></i> Putar Interactive Player

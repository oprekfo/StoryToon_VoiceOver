        function clearScript() {
            document.getElementById('story-text').value = '';
            document.getElementById('custom-character-override').value = '';
            updateTextStats();
        }

        function normalizeNumbersInScript() {
            let text = document.getElementById('story-text').value;
            if (!text.trim()) return;

            text = text.replace(/Rp\s*([\d.]+)/gi, (match, p1) => {
                return p1.replace(/\./g, '') + ' rupiah';
            });
            text = text.replace(/\b1\b/g, 'satu');
            text = text.replace(/\b2\b/g, 'dua');
            text = text.replace(/\b3\b/g, 'tiga');
            text = text.replace(/\b4\b/g, 'empat');
            text = text.replace(/\b5\b/g, 'lima');

            document.getElementById('story-text').value = text;
            updateTextStats();
            showToast("Ejaan naskah berhasil dinormalisasi!", "success");
        }

        function scrollToSection(id) {
            document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
        }

        function showToast(msg, type = "info") {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-message');
            const iconEl = document.getElementById('toast-icon');

            msgEl.textContent = msg;
            
            if (type === "error") {
                iconEl.innerHTML = `<i data-lucide="alert-circle" class="w-5 h-5 text-red-400"></i>`;
            } else if (type === "success") {
                iconEl.innerHTML = `<i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400"></i>`;
            } else {
                iconEl.innerHTML = `<i data-lucide="info" class="w-5 h-5 text-purple-400"></i>`;
            }
            lucide.createIcons();

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        function pcmToWavBlob(pcm16, sampleRate = 24000) {
            const numChannels = 1;
            const bytesPerSample = 2;
            const blockAlign = numChannels * bytesPerSample;
            const byteRate = sampleRate * blockAlign;
            const dataSize = pcm16.length * bytesPerSample;
            const buffer = new ArrayBuffer(44 + dataSize);
            const view = new DataView(buffer);

            writeString(view, 0, 'RIFF');
            view.setUint32(4, 36 + dataSize, true);
            writeString(view, 8, 'WAVE');
            writeString(view, 12, 'fmt ');
            view.setUint32(16, 16, true);
            view.setUint16(20, 1, true);
            view.setUint16(22, numChannels, true);
            view.setUint32(24, sampleRate, true);
            view.setUint32(28, byteRate, true);
            view.setUint16(32, blockAlign, true);
            view.setUint16(34, 16, true);
            writeString(view, 36, 'data');
            view.setUint32(40, dataSize, true);

            let offset = 44;
            for (let i = 0; i < pcm16.length; i++, offset += 2) {
                view.setInt16(offset, pcm16[i], true);
            }

            return new Blob([buffer], { type: 'audio/wav' });
        }

        function writeString(view, offset, string) {
            for (let i = 0; i < string.length; i++) {
                view.setUint8(offset + i, string.charCodeAt(i));
            }
        }

        function base64ToInt16Array(base64) {
            const binaryString = atob(base64);
            const len = binaryString.length;
            const bytes = new Uint8Array(len);
            for (let i = 0; i < len; i++) {
                bytes[i] = binaryString.charCodeAt(i);
            }
            return new Int16Array(bytes.buffer);
        }

        async function startStoryPipeline() {
            const storyText = document.getElementById('story-text').value.trim();
            const artStyle = document.getElementById('art-style')?.value || '2d-storybook';
            const sceneCount = document.getElementById('scene-count')?.value || 'auto';
            const selectedAspect = document.querySelector('input[name="aspect-ratio"]:checked')?.value || '16:9';
            const voiceTalent = document.getElementById('voice-talent')?.value || 'Kore';
            const voiceStyle = document.getElementById('voice-style')?.value || 'Say with storytelling drama and warmth in Indonesian';
            const customCharOverride = document.getElementById('custom-character-override').value.trim();

            if (!storyText) {
                showToast("Silakan masukkan naskah cerita terlebih dahulu!", "error");
                return;
            }

            if (isProcessing) return;
            isProcessing = true;

            document.getElementById('progress-section').classList.remove('hidden');
            document.getElementById('storyboard-section').classList.add('hidden');
            updateProgress(10, "Menganalisis Naskah & Karakter...", "Mendeteksi karakter utama dan mengunci spesifikasi visual...");

            const btn = document.getElementById('btn-generate-story');
            btn.disabled = true;
            btn.classList.add('opacity-50', 'cursor-not-allowed');

            try {
                let analysisResult;
                try {
                    analysisResult = await analyzeStoryAndCharactersWithGemini(storyText, sceneCount, customCharOverride);
                } catch (apiErr) {
                    console.warn("Fallback parser digunakan:", apiErr);
                    analysisResult = fallbackParseStoryResult(storyText, sceneCount, customCharOverride);
                }

                globalCharacterSheet = analysisResult.characterSheetPrompt || "Consistent cartoon main characters with fixed hair, eyes, and outfits across scenes.";
                const scenes = analysisResult.scenes || [];

                // Display Character Lock Sheet Info Banner
                document.getElementById('character-summary-desc').textContent = analysisResult.characterSheetDescription || globalCharacterSheet;

                const totalScenesCount = scenes.length;
                scenesData = scenes.map((s, idx) => {
                    let type = s.sceneType;
                    if (!type) {
                        if (idx === 0) type = 'TITLE';
                        else if (idx === totalScenesCount - 1) type = 'MORAL';
                        else type = 'STORY';
                    }
                    return {
                        id: idx + 1,
                        sceneType: type,
                        snippet: s.textSnippet,
                        visualDescription: s.visualDescription,
                        prompt: s.imagePrompt || s.textSnippet,
                        voiceoverText: s.textSnippet,
                        imgStatus: 'pending',
                        audioStatus: 'pending',
                        imageUrl: null,
                        audioUrl: null,
                        audioBuffer: null,
                        imgErrorMsg: null,
                        audioErrorMsg: null
                    };
                });

                updateProgress(30, "Karakter & Storyboard Terkunci", `Berhasil mengunci model karakter. Ditemukan ${scenesData.length} adegan. Memulai pembuatan gambar konsisten...`);

                renderScenesUI();
                document.getElementById('storyboard-section').classList.remove('hidden');
                scrollToSection('storyboard-section');

                await processAllScenesPipeline(artStyle, selectedAspect, voiceTalent, voiceStyle);

            } catch (err) {
                console.error("Pipeline Error:", err);
                showToast("Terjadi kesalahan: " + (err.message || "Gagal memproses cerita"), "error");
                updateProgress(100, "Pemrosesan Terhenti", "Terjadi kesalahan.", true);
            } finally {
                isProcessing = false;
                if (btn) {
                    btn.disabled = false;
                    btn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
            }
        }

        async function analyzeStoryAndCharactersWithGemini(storyText, targetCount, customOverride) {
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const prompt = `Analisis naskah cerita anak berikut dan buatlah:
1. DETEKSI KARAKTER & KONSISTENSI VISUAL: Identifikasi karakter utama dalam naskah (nama, umur, bentuk wajah, mata, rambut, pakaian/baju, warna spesifik baju, celana, serta aksesori). Buatlah "characterSheetPrompt" dalam Bahasa Inggris ringkas yang MENGUNCI penampilan setiap karakter sehingga SAMA PERSIS di setiap adegan.
2. PEMBAGIAN ADEGAN: Bagi naskah menjadi beberapa adegan (target jumlah adegan: ${targetCount}).

STRUKTUR ADEGAN MANDATORI:
- ADEGAN 1 (TITLE): Judul Cerita + Cover Visual + Narasi Judul Pembuka.
- ADEGAN 2 hingga N-1 (STORY): Alur kisah utama berurutan.
- ADEGAN N (MORAL): Pesan moral & inspirasi dongeng.

${customOverride ? `CATATAN PENTING USER KUSTOM KARAKTER: ${customOverride}` : ''}

Naskah Cerita:
"""
${storyText}
"""`;

            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "OBJECT",
                        properties: {
                            characterSheetDescription: { type: "STRING", description: "Deskripsi Bahasa Indonesia tentang model karakter konsisten (baju, wajah, warna)" },
                            characterSheetPrompt: { type: "STRING", description: "Detailed English visual description locking hair, eyes, facial features, clothes, color palette for all main characters to keep consistency" },
                            scenes: {
                                type: "ARRAY",
                                items: {
                                    type: "OBJECT",
                                    properties: {
                                        sceneNumber: { type: "INTEGER" },
                                        sceneType: { type: "STRING" },
                                        textSnippet: { type: "STRING" },
                                        visualDescription: { type: "STRING" },
                                        imagePrompt: { type: "STRING", description: "English prompt for this scene (without character details, as character details will be injected)" }
                                    },
                                    required: ["sceneNumber", "sceneType", "textSnippet", "visualDescription", "imagePrompt"]
                                }
                            }
                        },
                        required: ["characterSheetDescription", "characterSheetPrompt", "scenes"]
                    }
                }
            };

            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                throw new Error("Gagal menghubungi Gemini API untuk analisis karakter & adegan");
            }

            const data = await response.json();
            const text = data?.candidates?.[0]?.content?.parts?.[0]?.text;
            if (text) {
                return JSON.parse(text);
            }
            throw new Error("Respon analisis naskah kosong");
        }

        function fallbackParseStoryResult(storyText, sceneCount, customOverride) {
            const sentences = storyText.split(/(?<=[.!?])\s+/).filter(s => s.trim().length > 0);
            const firstLine = sentences[0] || storyText;
            const cleanTitle = firstLine.substring(0, 40).replace(/[^\w\s]/gi, '').trim();
            const storyTitle = cleanTitle ? `Petualangan ${cleanTitle}` : "Dongeng Ajaib";

            let charDesc = customOverride || "Bimo (anak laki-laki berambut cokelat pendek, memakai kaos merah terang dengan gambar bintang, celana jeans biru) dan Bolt (robot kecil perak dengan mata melingkar biru terang).";
            let charPrompt = customOverride || "MAIN CHARACTERS CONSISTENCY: Bimo is an 8-year-old boy with messy brown hair, wearing a bright red t-shirt with star logo, denim blue pants, yellow sneakers. Bolt is a small friendly silver metal robot with round glowing blue eyes, chest gear badge.";

            let totalDesired = 5;
            if (sceneCount && sceneCount !== 'auto' && !isNaN(parseInt(sceneCount))) {
                totalDesired = Math.max(parseInt(sceneCount), 3);
            } else {
                totalDesired = Math.min(Math.max(sentences.length + 2, 4), 7);
            }

            const scenes = [];

            scenes.push({
                sceneNumber: 1,
                sceneType: 'TITLE',
                textSnippet: `Judul Cerita: ${storyTitle}`,
                visualDescription: `Sampul utama buku cerita dongeng kartun dengan dekorasi megah dan tulisan judul "${storyTitle}".`,
                imagePrompt: `Cute fairytale title cover illustration, magical glowing frame, title artwork`
            });

            const middleCount = Math.max(totalDesired - 2, 1);
            const chunkSize = Math.ceil(sentences.length / middleCount) || 1;

            for (let i = 0; i < middleCount; i++) {
                const slice = sentences.slice(i * chunkSize, (i + 1) * chunkSize);
                const snippet = slice.join(' ') || sentences[sentences.length - 1] || storyText;
                if (snippet && snippet.trim()) {
                    scenes.push({
                        sceneNumber: scenes.length + 1,
                        sceneType: 'STORY',
                        textSnippet: snippet.trim(),
                        visualDescription: `Adegan cerita ${i + 1}: ${snippet.trim().substring(0, 90)}...`,
                        imagePrompt: `Story scene: ${snippet.trim().substring(0, 100)}`
                    });
                }
            }

            scenes.push({
                sceneNumber: scenes.length + 1,
                sceneType: 'MORAL',
                textSnippet: `Pesan & Inspirasi Moral: Setiap petualangan mengajarkan kita nilai kebaikan, keberanian, serta saling menolong sesama.`,
                visualDescription: `Adegan penutup yang hangat dan inspiratif, para karakter berkumpul dengan senyuman ceria di bawah sinar keemasan.`,
                imagePrompt: `Heartwarming storybook ending scene, cute characters smiling together under golden sunlight`
            });

            return {
                characterSheetDescription: charDesc,
                characterSheetPrompt: charPrompt,
                scenes: scenes
            };
        }

        async function processAllScenesPipeline(styleKey, aspectRatio, voiceTalent, voiceStyle) {
            const total = scenesData.length;
            let completed = 0;

            const promises = scenesData.map(async (scene, idx) => {
                scene.imgStatus = 'loading';
                updateSceneCardUI(scene);

                try {
                    const imgUrl = await fetchCartoonImage(scene.prompt, globalCharacterSheet, styleKey, aspectRatio);
                    scene.imageUrl = imgUrl;
                    scene.imgStatus = 'success';
                } catch (e) {
                    console.error("Image gen error for scene " + scene.id, e);
                    scene.imgStatus = 'error';
                    scene.imageUrl = generateFallbackCartoonSVG(scene.snippet, styleKey);
                }
                updateSceneCardUI(scene);

                scene.audioStatus = 'loading';
                updateSceneCardUI(scene);

                try {
                    const audioUrl = await fetchCartoonTTS(scene.voiceoverText, voiceTalent, voiceStyle);
                    scene.audioUrl = audioUrl;
                    scene.audioStatus = 'success';
                } catch (e) {
                    console.error("TTS gen error for scene " + scene.id, e);
                    scene.audioStatus = 'error';
                }
                updateSceneCardUI(scene);

                completed++;
                const percent = Math.min(30 + Math.round((completed / total) * 70), 100);
                updateProgress(percent, "Menghasilkan Gambar & Suara Konsisten...", `Adegan ${completed} dari ${total} selesai dibuat.`);
            });

            await Promise.all(promises);
            updateProgress(100, "Seluruh Storyboard Selesai!", "Gambar ilustrasi konsisten dan suara narasi telah siap.");
            setTimeout(() => {
                document.getElementById('progress-section').classList.add('hidden');
            }, 2500);
            showToast("Proses pembuatan Storyboard konsisten selesai!", "success");
        }

        async function fetchCartoonImage(basePrompt, characterSheet, styleKey, aspectRatio) {
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${apiKey}`;

            const styleModifiers = {
                '3d-pixar': '3D Pixar Disney animated movie style, vibrant rich lighting, expressive cute character design, digital render, highly detailed',
                '2d-storybook': '2D classic children storybook illustration style, clean line art, warm soft pastel colors, fairytale aesthetic',
                'anime-cute': 'Cute anime fantasy art style, vibrant colors, expressive anime eyes, smooth cell shading, anime storybook art',
                'comic-vibrant': 'Vibrant colorful comic book illustration, dynamic panel art, expressive lines, bold color palette',
                'watercolor': 'Soft watercolor storybook cartoon illustration, gentle artistic brush strokes, magical dreamlike aesthetic'
            };

            const selectedStyle = styleModifiers[styleKey] || styleModifiers['2d-storybook'];
            const fullPrompt = `[CHARACTER DESIGNS AND COSTUMES (MUST BE STRICTLY IDENTICAL ACROSS ALL SCENES): ${characterSheet}]. [ART STYLE: ${selectedStyle}]. [SCENE ACTION: ${basePrompt}]. High visual quality, vibrant cute cartoon style, storybook illustration, clean face details, consistent clothing colors and character appearance.`;

            const payload = {
                contents: [{
                    role: 'user',
                    parts: [{ text: fullPrompt }]
                }],
                generationConfig: {
                    responseModalities: ['IMAGE'],
                    imageConfig: { aspectRatio: aspectRatio || "16:9" }
                }
            };

            let response = null;
            let retries = 2;

            while (retries > 0) {
                try {
                    response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (response.ok) break;
                } catch (e) {
                    console.warn(`Retry Image Generation (${retries} left)...`);
                }
                retries--;
                if (retries > 0) {
                    await new Promise(r => setTimeout(r, 1000));
                }
            }

            if (response && response.ok) {
                const result = await response.json();
                const base64Data = result?.candidates?.[0]?.content?.parts?.find(p => p.inlineData)?.inlineData?.data;
                if (base64Data) {
                    return `data:image/png;base64,${base64Data}`;
                }
            }

            return generateFallbackCartoonSVG(basePrompt, styleKey);
        }

        function generateFallbackCartoonSVG(promptText, styleKey) {
            const gradients = [
                ['#4f46e5', '#7c3aed', '#ec4899'],
                ['#0284c7', '#0d9488', '#10b981'],
                ['#d97706', '#ea580c', '#e11d48'],
                ['#8b5cf6', '#d946ef', '#06b6d4']
            ];
            const palette = gradients[Math.floor(Math.random() * gradients.length)];
            const cleanText = escapeHtml(promptText.substring(0, 60)) + '...';

            const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="100%" height="100%">
                <defs>
                    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="${palette[0]}" />
                        <stop offset="50%" stop-color="${palette[1]}" />
                        <stop offset="100%" stop-color="${palette[2]}" />
                    </linearGradient>
                </defs>
                <rect width="1280" height="720" fill="url(#bgGrad)" />
                <circle cx="250" cy="180" r="200" fill="#ffffff" opacity="0.12" />
                <circle cx="1050" cy="540" r="280" fill="#ffffff" opacity="0.1" />
                <g transform="translate(640, 360)">
                    <rect x="-300" y="-120" width="600" height="240" rx="24" fill="rgba(15, 23, 42, 0.75)" stroke="rgba(255, 255, 255, 0.25)" stroke-width="2" />
                    <text x="0" y="-30" font-family="sans-serif" font-size="42" font-weight="bold" fill="#ffffff" text-anchor="middle">🎨 StoryToon AI Scene</text>
                    <text x="0" y="25" font-family="sans-serif" font-size="20" fill="#fef08a" text-anchor="middle">${cleanText}</text>
                    <text x="0" y="65" font-family="sans-serif" font-size="15" fill="#94a3b8" text-anchor="middle">Style: ${(styleKey || '2d-storybook').toUpperCase()}</text>
                </g>
            </svg>`;

            return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
        }

        async function fetchCartoonTTS(text, voiceName, voiceStyle) {
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${apiKey}`;

            const fullPrompt = `${voiceStyle || 'Say cheerfully in Indonesian'}: ${text}`;

            const payload = {
                contents: [{
                    parts: [{ text: fullPrompt }]
                }],
                generationConfig: {
                    responseModalities: ["AUDIO"],
                    speechConfig: {
                        voiceConfig: {
                            prebuiltVoiceConfig: { voiceName: voiceName || "Kore" }
                        }
                    }
                }
            };

            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const result = await response.json();
                    const part = result?.candidates?.[0]?.content?.parts?.[0];
                    const audioData = part?.inlineData?.data;
                    const mimeType = part?.inlineData?.mimeType;

                    if (audioData) {
                        let sampleRate = 24000;
                        if (mimeType && mimeType.includes('rate=')) {
                            const match = mimeType.match(/rate=(\d+)/);
                            if (match) sampleRate = parseInt(match[1], 10);
                        }

                        const pcm16 = base64ToInt16Array(audioData);
                        const wavBlob = pcmToWavBlob(pcm16, sampleRate);
                        return URL.createObjectURL(wavBlob);
                    }
                }
            } catch (err) {
                console.warn("Gemini TTS API failed, trying fallback WebSpeech...", err);
            }

            return createFallbackAudioFromSpeech(text);
        }

        function createFallbackAudioFromSpeech(text) {
            return new Promise((resolve) => {
                if ('speechSynthesis' in window) {
                    const utterance = new SpeechSynthesisUtterance(text);
                    utterance.lang = 'id-ID';
                    utterance.rate = 0.95;
                    
                    const simulatedBlob = new Blob([], { type: 'audio/wav' });
                    const simulatedUrl = URL.createObjectURL(simulatedBlob);
                    resolve(simulatedUrl);
                } else {
                    resolve(null);
                }
            });
        }


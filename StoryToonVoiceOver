        function updateTextStats() {
            const text = document.getElementById('story-text').value;
            const charCount = text.length;
            const wordCount = text.trim() ? text.trim().split(/\s+/).length : 0;
            
            const estSeconds = Math.ceil(wordCount / 2.5);
            const mins = Math.floor(estSeconds / 60).toString().padStart(2, '0');
            const secs = (estSeconds % 60).toString().padStart(2, '0');

            document.getElementById('stat-char').textContent = charCount;
            document.getElementById('stat-words').textContent = wordCount;
            document.getElementById('stat-est-time').textContent = `${mins}:${secs}`;
        }

        function loadPresetStory(key) {
            if (key && PRESET_STORIES[key]) {
                const textarea = document.getElementById('story-text');

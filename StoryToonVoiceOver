            if (activeAudio) {
                activeAudio.pause();
                resetAudioButtons();
            }

            activeAudio = new Audio(scene.audioUrl);
            const playIcon = document.getElementById(`icon-play-${sceneId}`);
            const playLabel = document.getElementById(`label-play-${sceneId}`);

            if (playIcon) playIcon.setAttribute('data-lucide', 'pause');

                showToast(`Suara Adegan ${scene.id} berhasil diperbarui!`, "success");
            } catch (e) {
                scene.audioStatus = 'error';
                showToast(`Gagal memperbarui suara Adegan ${scene.id}`, "error");
            }
            updateSceneCardUI(scene);
        }

        function switchViewMode(mode) {
            const gridView = document.getElementById('view-grid');
            const storybookView = document.getElementById('view-storybook');
            const gridBtn = document.getElementById('tab-grid-btn');
            const storybookBtn = document.getElementById('tab-storybook-btn');

            if (mode === 'grid') {
                gridView.classList.remove('hidden');
                storybookView.classList.add('hidden');
                gridBtn.className = "px-3 py-1.5 rounded-lg bg-purple-600 text-white shadow flex items-center gap-1.5";
                storybookBtn.className = "px-3 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 flex items-center gap-1.5";
            } else {
                gridView.classList.add('hidden');
                storybookView.classList.remove('hidden');
                gridBtn.className = "px-3 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 flex items-center gap-1.5";
                storybookBtn.className = "px-3 py-1.5 rounded-lg bg-purple-600 text-white shadow flex items-center gap-1.5";
            }
        }

        function startCinemaPresentation() {
            if (scenesData.length === 0) return;
            currentCinemaIndex = 0;
            document.getElementById('cinema-modal').classList.remove('hidden');
            loadCinemaScene(currentCinemaIndex);
        }

        function loadCinemaScene(index) {
            if (index < 0 || index >= scenesData.length) return;
            currentCinemaIndex = index;

            const scene = scenesData[index];
            const imgEl = document.getElementById('cinema-img');
            const captionEl = document.getElementById('cinema-caption');
            const indicatorEl = document.getElementById('cinema-scene-indicator');

            let typeLabel = `Adegan ${scene.id}`;
            if (scene.sceneType === 'TITLE') typeLabel = `🎬 Judul Cerita`;
            else if (scene.sceneType === 'MORAL') typeLabel = `🌟 Pesan & Inspirasi`;

            imgEl.src = scene.imageUrl || generateFallbackCartoonSVG(scene.snippet, '2d-storybook');
            captionEl.textContent = `"${scene.snippet}"`;
            indicatorEl.textContent = `${typeLabel} (${index + 1} dari ${scenesData.length})`;

            if (isCinemaPlaying) {
                playCinemaCurrentAudio();
            }
        }

        function toggleCinemaPlay() {
            isCinemaPlaying = !isCinemaPlaying;
            const playIcon = document.getElementById('cinema-play-icon');

            if (isCinemaPlaying) {
                if (playIcon) playIcon.setAttribute('data-lucide', 'pause');
                playCinemaCurrentAudio();
            } else {
                if (playIcon) playIcon.setAttribute('data-lucide', 'play');
                if (activeAudio) activeAudio.pause();
            }
            lucide.createIcons();
        }

        function playCinemaCurrentAudio() {
            const scene = scenesData[currentCinemaIndex];
            if (!scene || !scene.audioUrl) {
                setTimeout(() => {
                    if (isCinemaPlaying) nextCinemaScene();
                }, 4000);
                return;
            }

            if (activeAudio) activeAudio.pause();
            activeAudio = new Audio(scene.audioUrl);

            activeAudio.onended = () => {
                if (isCinemaPlaying) {
                    if (currentCinemaIndex < scenesData.length - 1) {
                        setTimeout(() => nextCinemaScene(), 800);
                    } else {
                        isCinemaPlaying = false;
                        const playIcon = document.getElementById('cinema-play-icon');
                        if (playIcon) playIcon.setAttribute('data-lucide', 'play');
                        lucide.createIcons();
                    }
                }
            };

            activeAudio.play();
        }

        function nextCinemaScene() {
            if (currentCinemaIndex < scenesData.length - 1) {
                loadCinemaScene(currentCinemaIndex + 1);
            }
        }

        function prevCinemaScene() {
            if (currentCinemaIndex > 0) {
                loadCinemaScene(currentCinemaIndex - 1);
            }
        }

        function closeCinemaModal() {
            document.getElementById('cinema-modal').classList.add('hidden');
            isCinemaPlaying = false;
            if (activeAudio) activeAudio.pause();
        }

        async function startVideoExport() {
            if (scenesData.length === 0) {
                showToast("Belum ada adegan yang dibuat!", "error");
                return;
            }

            const selectedAspect = document.querySelector('input[name="aspect-ratio"]:checked')?.value || '16:9';
            const previewBox = document.getElementById('export-preview-box');
            if (previewBox) {
                previewBox.className = "relative w-full bg-black rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center shadow-inner max-h-[60vh] mx-auto ";
                if (selectedAspect === '9:16') {
                    previewBox.classList.add('aspect-[9/16]', 'max-w-[340px]');
                } else if (selectedAspect === '1:1') {
                    previewBox.classList.add('aspect-square', 'max-w-[480px]');
                } else {
                    previewBox.classList.add('aspect-video');
                }
            }

            const modal = document.getElementById('video-export-modal');
            const canvas = document.getElementById('export-canvas');
            const videoPlayer = document.getElementById('export-video-player');
            const overlay = document.getElementById('export-rendering-overlay');
            const downloadBtn = document.getElementById('btn-download-video');

            modal.classList.remove('hidden');
            videoPlayer.classList.add('hidden');
            canvas.classList.remove('hidden');
            overlay.classList.remove('hidden');
            downloadBtn.classList.add('hidden');

            document.getElementById('export-status-desc').textContent = "Proses merekam visual & audio adegan sedang berjalan...";

            try {
                await renderMergedVideoProcess(canvas, videoPlayer, downloadBtn, overlay, selectedAspect);
            } catch (err) {
                console.error("Export Video Error:", err);
                showToast("Gagal menggabungkan video: " + err.message, "error");
                overlay.innerHTML = `
                    <p class="text-red-400 font-bold">Gagal Membuat Video</p>
                    <p class="text-xs text-slate-400">${escapeHtml(err.message)}</p>
                `;
            }
        }

        async function renderMergedVideoProcess(canvas, videoPlayer, downloadBtn, overlay, aspectRatio) {
            const ctx = canvas.getContext('2d');
            
            let width = 1280;
            let height = 720;
            if (aspectRatio === '9:16') {
                width = 720;
                height = 1280;
            } else if (aspectRatio === '1:1') {
                width = 1080;
                height = 1080;
            }

            canvas.width = width;
            canvas.height = height;

            const transitionType = document.getElementById('transition-type')?.value || 'crossfade';

            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const dest = audioCtx.createMediaStreamDestination();

            const canvasStream = canvas.captureStream(30);

            const combinedStream = new MediaStream([
                ...canvasStream.getVideoTracks(),
                ...dest.stream.getAudioTracks()
            ]);

            let mimeType = 'video/webm;codecs=vp8,opus';
            if (!MediaRecorder.isTypeSupported(mimeType)) {
                mimeType = 'video/webm';
            }

            const mediaRecorder = new MediaRecorder(combinedStream, { mimeType });
            const chunks = [];

            mediaRecorder.ondataavailable = (e) => {
                if (e.data.size > 0) chunks.push(e.data);
            };

            mediaRecorder.start();

            const totalScenes = scenesData.length;

            document.getElementById('export-render-text').textContent = "Memuat aset gambar adegan konsisten...";
            const loadedImages = [];
            for (let i = 0; i < totalScenes; i++) {
                const scene = scenesData[i];
                const img = await loadImage(scene.imageUrl || generateFallbackCartoonSVG(scene.snippet, '2d-storybook'));
                loadedImages.push(img);
            }

            const motionTypes = ['zoom-in', 'pan-right', 'zoom-out', 'pan-left'];

            for (let i = 0; i < totalScenes; i++) {
                const scene = scenesData[i];
                const sceneNum = i + 1;
                const currentImg = loadedImages[i];
                const prevImg = i > 0 ? loadedImages[i - 1] : null;

                const percent = Math.round(((i) / totalScenes) * 100);
                document.getElementById('export-progress-label').textContent = `Merekam Adegan ${sceneNum} / ${totalScenes}`;
                document.getElementById('export-progress-percent').textContent = `${percent}%`;
                document.getElementById('export-progress-bar').style.width = `${percent}%`;
                document.getElementById('export-render-text').textContent = `Merekam Adegan ${sceneNum} (${transitionType})...`;

                let audioDuration = 4000;
                let audioSource = null;

                if (scene.audioUrl) {
                    try {
                        const response = await fetch(scene.audioUrl);
                        const arrayBuffer = await response.arrayBuffer();
                        const audioBuffer = await audioCtx.decodeAudioData(arrayBuffer);

                        audioDuration = Math.max(audioBuffer.duration * 1000, 3000);

                        audioSource = audioCtx.createBufferSource();
                        audioSource.buffer = audioBuffer;
                        audioSource.connect(dest);
                        audioSource.connect(audioCtx.destination);
                        audioSource.start();
                    } catch (e) {
                        console.warn("Audio decode error for export:", e);
                    }
                }

                const transitionMs = 1000;
                const motionType = motionTypes[i % motionTypes.length];
                const prevMotionType = i > 0 ? motionTypes[(i - 1) % motionTypes.length] : null;

                const startTime = performance.now();
                while (performance.now() - startTime < audioDuration) {
                    const elapsed = performance.now() - startTime;
                    const progress = elapsed / audioDuration;

                    ctx.clearRect(0, 0, width, height);

                    if (i > 0 && elapsed < transitionMs) {
                        const tProg = elapsed / transitionMs;
                        renderTransitionFrame(ctx, prevImg, currentImg, tProg, transitionType, width, height, prevMotionType, motionType, progress);
                    } else {
                        ctx.save();
                        ctx.globalAlpha = 1.0;
                        drawKenBurnsFrame(ctx, currentImg, progress, width, height, motionType);
                        ctx.restore();
                    }

                    await new Promise(r => setTimeout(r, 33));
                }
            }

            document.getElementById('export-progress-percent').textContent = `100%`;
            document.getElementById('export-progress-bar').style.width = `100%`;

            mediaRecorder.stop();

            await new Promise((resolve) => {
                mediaRecorder.onstop = resolve;
            });

            const blob = new Blob(chunks, { type: 'video/webm' });
            const videoUrl = URL.createObjectURL(blob);

            overlay.classList.add('hidden');
            canvas.classList.add('hidden');
            videoPlayer.classList.remove('hidden');
            videoPlayer.src = videoUrl;

            downloadBtn.href = videoUrl;
            downloadBtn.classList.remove('hidden');

            document.getElementById('export-status-desc').textContent = "Penggabungan video selesai! Klik tombol di bawah untuk mengunduh.";
            showToast("Video cerita utuh dengan transisi profesional selesai!", "success");
        }

        function renderTransitionFrame(ctx, prevImg, currentImg, tProg, type, width, height, prevMotion, curMotion, curProgress) {
            if (type === 'fade-black') {
                if (tProg < 0.5) {
                    const alpha = 1.0 - (tProg * 2);
                    ctx.save();
                    ctx.globalAlpha = Math.max(alpha, 0);
                    drawKenBurnsFrame(ctx, prevImg, 1.0, width, height, prevMotion || 'zoom-in');
                    ctx.restore();
                } else {
                    const alpha = (tProg - 0.5) * 2;
                    ctx.save();
                    ctx.globalAlpha = Math.min(alpha, 1.0);
                    drawKenBurnsFrame(ctx, currentImg, curProgress, width, height, curMotion);
                    ctx.restore();
                }
            } else if (type === 'slide-left') {
                const offsetX = tProg * width;
                ctx.save();
                ctx.drawImage(prevImg, -offsetX, 0, width, height);
                ctx.drawImage(currentImg, width - offsetX, 0, width, height);
                ctx.restore();
            } else if (type === 'zoom-burst') {
                const scale = 1.0 + (tProg * 0.4);
                ctx.save();
                ctx.globalAlpha = 1.0 - tProg;
                ctx.translate(width / 2, height / 2);
                ctx.scale(scale, scale);
                ctx.translate(-width / 2, -height / 2);
                ctx.drawImage(prevImg, 0, 0, width, height);
                ctx.restore();

                ctx.save();
                ctx.globalAlpha = tProg;
                drawKenBurnsFrame(ctx, currentImg, curProgress, width, height, curMotion);
                ctx.restore();
            } else if (type === 'wipe-right') {
                const wipeX = tProg * width;
                ctx.save();
                drawKenBurnsFrame(ctx, prevImg, 1.0, width, height, prevMotion || 'zoom-in');
                ctx.restore();

                ctx.save();
                ctx.beginPath();
                ctx.rect(0, 0, wipeX, height);
                ctx.clip();
                drawKenBurnsFrame(ctx, currentImg, curProgress, width, height, curMotion);
                ctx.restore();
            } else {
                // Default Crossfade
                ctx.save();
                ctx.globalAlpha = 1.0 - tProg;
                drawKenBurnsFrame(ctx, prevImg, 1.0, width, height, prevMotion || 'zoom-in');
                ctx.restore();

                ctx.save();
                ctx.globalAlpha = tProg;
                drawKenBurnsFrame(ctx, currentImg, curProgress, width, height, curMotion);
                ctx.restore();
            }
        }

        function drawKenBurnsFrame(ctx, img, progress, width, height, motionType) {
            let scale = 1.0;
            let dx = 0;
            let dy = 0;

            if (motionType === 'zoom-in') {
                scale = 1.0 + (progress * 0.08);
            } else if (motionType === 'zoom-out') {
                scale = 1.08 - (progress * 0.08);
            } else if (motionType === 'pan-right') {
                scale = 1.06;
                dx = (progress - 0.5) * (width * 0.04);
            } else if (motionType === 'pan-left') {
                scale = 1.06;
                dx = (0.5 - progress) * (width * 0.04);
            } else {
                scale = 1.0 + (progress * 0.05);
            }

            const w = width * scale;
            const h = height * scale;
            const x = ((width - w) / 2) + dx;
            const y = ((height - h) / 2) + dy;

            ctx.drawImage(img, x, y, w, h);
        }

        function loadImage(src) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.crossOrigin = 'anonymous';
                img.onload = () => resolve(img);
                img.onerror = (e) => reject(e);
                img.src = src;
            });
        }

        function closeVideoExportModal() {
            document.getElementById('video-export-modal').classList.add('hidden');
        }

        function openImageModal(sceneId) {
            const scene = scenesData.find(s => s.id === parseInt(sceneId));
            if (!scene) return;

            document.getElementById('modal-title').textContent = `Adegan ${scene.id} - Detail Gambar AI`;
            document.getElementById('modal-img').src = scene.imageUrl;
            document.getElementById('modal-snippet').textContent = `"${scene.snippet}"`;
            
            const dlBtn = document.getElementById('modal-download-btn');
            dlBtn.href = scene.imageUrl;
            dlBtn.download = `storytoon-adegan-${scene.id}.png`;

            document.getElementById('image-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('image-modal').classList.add('hidden');
        }

        function regenerateAllPipeline() {
            startStoryPipeline();
        }
    </script>
